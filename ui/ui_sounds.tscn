[sub_resource type="AudioStreamRandomizer" id="AudioStreamRandomizer_key"]
random_pitch = 1.15
streams_count = 1
stream_0/stream = ExtResource("12_key")

[node name="UiSounds" type="Node"]
process_mode = 3

[node name="Click" type="AudioStreamPlayer" parent="."]
stream = ExtResource("1_click")
