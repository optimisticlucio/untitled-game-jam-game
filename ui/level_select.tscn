[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://ui/level_select.gd" id="2_script"]
[ext_resource type="Texture2D" path="res://ui/art/menu_background_blur.png" id="3_bg"]
[ext_resource type="Texture2D" path="res://ui/icons/back.svg" id="4_back"]

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 0
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("3_bg")
expand_mode = 1
stretch_mode = 6

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="Margin/Column/TopBar"]
theme_type_variation = &"IconButton"
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 100)
layout_mode = 2
icon = ExtResource("4_back")
icon_alignment = 1
expand_icon = true

[node name="Title" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
theme_type_variation = &"ScreenTitle"
text = "Levels"
vertical_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Cards" type="VBoxContainer" parent="Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16
